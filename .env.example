# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE CONFIGURATION (SQLite Local Database)
DATABASE_URL="file:./dev.db"

# ADMINISTRATOR AUTHENTICATION (Foundation Polytechnic VPN Management Portal)
# Initial administrator credentials for seeding and development
ADMIN_EMAIL=
ADMIN_PASSWORD=
SESSION_SECRET=

# WIREGUARD VPN SERVER CONFIGURATION (Windows / Foundation Polytechnic)
# Interface name (e.g. MyVPN-Server)
WG_INTERFACE=MyVPN-Server
# Server internal address
WG_SERVER_ADDRESS=10.8.0.1
# Listening UDP port
WG_SERVER_PORT=63196
# Server public or LAN endpoint (e.g., 192.168.1.181:63196 for local development)
WG_SERVER_ENDPOINT=192.168.1.181:63196
# DNS pushed to connecting clients
WG_CLIENT_DNS=1.1.1.1
# Path to WireGuard CLI on Windows
WG_EXE_PATH=C:\Program Files\WireGuard\wg.exe
# Configured server public key (used if WireGuard CLI is unreachable or for development configuration)
WG_SERVER_PUBLIC_KEY=
# Optional service mode override: 'real', 'mock', or 'auto' (default: auto)
WG_USE_MOCK=false

# Peer handshake active threshold in seconds (default: 180)
WG_HANDSHAKE_TIMEOUT_SECONDS=180

